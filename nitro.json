{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["visioncameraocr"],
  "ios": {
    "iosModuleName": "VisionCameraOcr"
  },
  "android": {
    "androidNamespace": ["visioncameraocr"],
    "androidCxxLibName": "VisionCameraOcr"
  },
  "autolinking": {
    "OcrProcessor": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridOcrProcessor"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridOcrProcessor"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
